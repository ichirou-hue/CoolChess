# ==========================================
# Окружение и секреты
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Шахматные AI-веса и большие бинарники
# ==========================================
backend/models/*
!backend/models/.gitkeep
*.pt
*.onnx
*.bin
*.engine
*.nnue
*.binpack

# ==========================================
# Датасеты и локальные дампы
# ==========================================
data/source/
*.pgn
*.csv
*.parquet
*.sqlite3
*.db

# ==========================================
# Python, виртуальные окружения и кэш
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

venv/
.venv/
env/
ENV/

# ==========================================
# Тестирование и Coverage
# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# ==========================================
# Node / Frontend (Vite / React / Next)
# ==========================================
node_modules/
dist/
build/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# IDE, редакторы и системные файлы
# ==========================================
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Внутренние утилиты и временные рендеры
# ==========================================
.tools/
_docx_render/
*.log
tmp/
temp/