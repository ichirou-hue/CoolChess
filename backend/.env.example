# Пример окружения backend. Скопируйте в backend/.env (его читает docker-compose env_file).
# Генерация секрета: python -c "import secrets; print(secrets.token_urlsafe(32))"

DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/coolchess
JWT_SECRET=сгенерируйте_32+_символов
VERIFY_SECRET=сгенерируйте_32+_символов
ENV=production
CORS_ORIGINS=http://localhost,http://127.0.0.1
