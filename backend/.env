# База данных PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=coolchess
POSTGRES_PORT=5432

# Строка подключения для SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/coolchess

# Секретные ключи для JWT и подтверждений
JWT_SECRET=super_secret_jwt_key_coolchess_2026
VERIFY_SECRET=super_secret_verify_key_coolchess_2026
