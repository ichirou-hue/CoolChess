# Пример окружения CoolChess. Скопируйте в .env (корень) и backend/.env, заполните секреты.
# Генерация секрета: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=coolchess
POSTGRES_PORT=5433

# --- Backend ---
# Docker: postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@postgres:5432/coolchess
# Локально:  postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@localhost:5433/coolchess
# Без Docker: sqlite+aiosqlite:///./coolchess.db
DATABASE_URL=postgresql+asyncpg://postgres:SET_POSTGRES_PASSWORD@localhost:5433/coolchess
JWT_SECRET=сгенерируйте_32+_символов
VERIFY_SECRET=сгенерируйте_32+_символов
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- Email verification (SMTP) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=false
SMTP_USE_SSL=true
FRONTEND_URL=http://localhost:5173

# --- Frontend (frontend/.env) ---
# Пусто для dev: Vite проксирует /api на backend :8080 (см. frontend/vite.config.ts).
VITE_API_URL=
