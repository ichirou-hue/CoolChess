# Пример окружения backend CoolChess. Скопируйте в .env и заполните секреты.
# .env не коммитится (см. .gitignore).

# --- Окружение: development | production | test ---
ENV=development

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=coolchess
POSTGRES_PORT=5433

# --- SQLAlchemy URL (asyncpg). Должен указывать на порт из compose/polices. ---
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/coolchess

# --- Секреты JWT (ОБЯЗАТЕЛЬНЫ вне тестов). Сгенерируйте, например:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_jwt_secret
VERIFY_SECRET=change_me_verify_secret

# --- CORS: список origin через запятую (wildcard запрещен) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
