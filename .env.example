# Пример окружения CoolChess. Скопируйте в .env (корень) и backend/.env, заполните секреты.
# Генерация секрета: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=coolchess
POSTGRES_PORT=5433

# --- Backend ---
# Docker: postgresql+asyncpg://postgres:postgrespassword@postgres:5432/coolchess
# Локально:  postgresql+asyncpg://postgres:postgrespassword@localhost:5433/coolchess
# Без Docker: sqlite+aiosqlite:///./coolchess.db
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/coolchess
JWT_SECRET=сгенерируйте_32+_символов
VERIFY_SECRET=сгенерируйте_32+_символов
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8080
